# Copia questo file in .env e compilalo.
# Dominio già puntato all'IP del server (record A/AAAA).
DOMINIO=grabby.example.it
# E-mail per gli avvisi di Let's Encrypt sul certificato.
EMAIL=tuo-indirizzo@example.it
# Download per IP all'ora.
GRABBY_LIMITE_ORARIO=10
# Dopo quanti giorni si cancellano le righe del registro.
GRABBY_CONSERVAZIONE_GIORNI=30
